# Copie para .env.local e preencha. Sem as variáveis do Supabase o app roda em
# modo demonstração (dados de exemplo, nada é gravado).

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Usados só pelo script de importação em lote (npm run importar)
SUPABASE_EMAIL=voce@exemplo.com
SUPABASE_SENHA=

# --- IA (basta uma das duas) ---
# claude | gemini. Sem esta linha, usa a primeira que tiver chave (Claude antes).
AI_PROVIDER=claude

ANTHROPIC_API_KEY=
# CLAUDE_MODEL_EDITAL=claude-sonnet-5-5
# CLAUDE_MODEL_TUTOR=claude-haiku-5-5

GEMINI_API_KEY=
# GEMINI_MODEL_EDITAL=gemini-3.8-flash
# GEMINI_MODEL_TUTOR=gemini-3.5-flash-lite
